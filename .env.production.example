# Production environment — copy to .env on the server and fill in secrets
APP_ENV=production

# PostgreSQL
POSTGRES_USER=dcb_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=digital_clan_books

DATABASE_URL=postgresql+asyncpg://dcb_user:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/digital_clan_books

# JWT (min 32 chars, unique random string)
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin (min 12 chars, not a common default)
ADMIN_EMAIL=admin@digitalclan.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# PayPal (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Storage (inside backend container — do not change)
EBOOK_STORAGE_PATH=/app/storage/secure/ebooks
PUBLIC_COVERS_PATH=/app/storage/public/covers
SECURE_EBOOKS_PATH=/app/storage/secure/ebooks
PUBLIC_COVERS_URL_PREFIX=/storage/public/covers

# cPanel account that owns the books subdomain (Apache proxy userdata path)
CPANEL_USER=digitalclanltd
BOOKS_DOMAIN=books.digitalclanltd.com
CORS_ORIGINS=https://books.digitalclanltd.com,http://books.digitalclanltd.com

MAX_UPLOAD_SIZE_MB=100

VITE_API_BASE_URL=/api
VITE_PAYPAL_CLIENT_ID=

# Optional seed reader account
READER_EMAIL=reader@digitalclan.com
READER_PASSWORD=CHANGE_ME_STRONG_READER_PASSWORD
