# Application environment: development | production
APP_ENV=development

# PostgreSQL
POSTGRES_USER=dcb_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=digital_clan_books

# Backend database URL (async)
DATABASE_URL=postgresql+asyncpg://dcb_user:change_me_strong_password@db:5432/digital_clan_books

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin seed
ADMIN_EMAIL=admin@digitalclan.com
ADMIN_PASSWORD=change_me_admin_password

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Storage paths (inside backend container)
EBOOK_STORAGE_PATH=/app/storage/secure/ebooks
PUBLIC_COVERS_PATH=/app/storage/public/covers
SECURE_EBOOKS_PATH=/app/storage/secure/ebooks
PUBLIC_COVERS_URL_PREFIX=/storage/public/covers

# CORS (comma-separated)
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Upload limits
MAX_UPLOAD_SIZE_MB=100

# Frontend build
VITE_API_BASE_URL=/api
VITE_PAYPAL_CLIENT_ID=
